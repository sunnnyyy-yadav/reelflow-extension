{
  "manifest_version": 3,
  "name": "ReelFlow AI — Instagram Reels Auto-Scroller",
  "version": "1.0.0",
  "description": "Smart hands-free auto-scroller for Instagram Reels with video-end detection, ad skipping, and custom pacing.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReelFlow AI Controls",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/reels/*",
        "https://www.instagram.com/reel/*",
        "https://www.instagram.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-autoscroll": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Command+Shift+R"
      },
      "description": "Toggle ReelFlow Auto-Scroll"
    },
    "skip-reel": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Command+Shift+Down"
      },
      "description": "Skip to Next Reel immediately"
    }
  }
}